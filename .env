# ─────────────────────────────────────────────
#  Shoonya (Finvasia) Credentials
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

SHOONYA_USER=YOUR_USER_ID
SHOONYA_PASSWORD=YOUR_PASSWORD
SHOONYA_TOTP_SECRET=YOUR_TOTP_SECRET_KEY   # from Shoonya 2FA setup
SHOONYA_VENDOR_CODE=YOUR_VENDOR_CODE
SHOONYA_API_SECRET=YOUR_API_SECRET
SHOONYA_IMEI=abc1234                        # any string, used as device ID

# ─────────────────────────────────────────────
#  Trading Parameters
# ─────────────────────────────────────────────

CAPITAL=1000                  # Total capital in INR
RISK_PER_TRADE_PCT=1.0        # % of capital to risk per trade (1% = ₹10)
MAX_TRADES_PER_DAY=3         # Hard limit on number of trades
MAX_LOSS_PER_DAY_PCT=2.0      # Stop all trading if daily loss exceeds this %

# Symbol to trade (NSE segment)
# Examples: SBIN-EQ, TATASTEEL-EQ, RELIANCE-EQ, HDFCBANK-EQ
SYMBOL=SBIN-EQ
EXCHANGE=NSE

# ─────────────────────────────────────────────
#  Strategy Settings
# ─────────────────────────────────────────────

# EMA Crossover
EMA_FAST=9
EMA_SLOW=21
EMA_SIGNAL=9

# RSI
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# ATR (for stop loss sizing)
ATR_PERIOD=14
ATR_MULTIPLIER=1.5            # SL = ATR * multiplier

# Candle interval in minutes (1, 3, 5, 10, 15)
CANDLE_INTERVAL=5

# ─────────────────────────────────────────────
#  Safety / Mode
# ─────────────────────────────────────────────

PAPER_TRADE=true              # Set to false only when READY for live trading
LOG_LEVEL=INFO
